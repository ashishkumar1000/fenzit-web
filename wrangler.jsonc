{
  // Cloudflare Workers with Static Assets: serves the Vite build as a SPA.
  // Unknown paths get the empty app shell (dist/404.html) with a 404 status, so React Router
  // renders the not-found page without the home page markup.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fenzit-web",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "fenzit.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
