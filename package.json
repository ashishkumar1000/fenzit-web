{
  "name": "fenzit-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare": "husky",
    "preinstall": "node -e \"if (!/bun\\//.test(process.env.npm_config_user_agent||'')) { console.error('\\nThis repo uses bun only. Run: bun install\\n'); process.exit(1); }\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:styles": "bun scripts/check-css-modules.ts",
    "tokens": "bun scripts/build-tokens.ts",
    "sync:design-system": "bun scripts/sync-design-system.ts",
    "check:design-system": "bun scripts/check-design-system.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "country-flag-icons": "1.6.20",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.14.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
