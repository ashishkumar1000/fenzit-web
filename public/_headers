# Cloudflare Workers static assets read this file. Hashed build files never change, so the
# browser and Cloudflare can keep them for a year. Files without a hash may change, so they
# get a short cache. The font has no hash in its name, so it is not marked immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=86400

/brand/*
  Cache-Control: public, max-age=86400
